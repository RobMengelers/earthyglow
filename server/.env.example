# Copy to server/.env and fill in.

# Postgres connection string. Defaults below match docker-compose.yml.
DATABASE_URL="postgresql://earthyglow:earthyglow@localhost:5433/earthyglow?schema=public"

# Mollie API key (test_xxx or live_xxx).
# Leave EMPTY to run the API in mock mode: no real payments, orders move to
# "paid" through the dev-only mock-pay endpoint so the flow can be tested.
MOLLIE_API_KEY=""

# Resend API key for sending the paid-order invoice email.
# Leave EMPTY to disable invoice emails (order flow still works).
RESEND_API_KEY=""

# Verified sender address for invoice emails (from your Resend-approved domain),
# e.g. "EarthyGlow <noreply@earthyglow.nl>".
EMAIL_FROM=""

# Port the API listens on.
PORT=4010

# Frontend origin: used for CORS and the Mollie redirectUrl.
# Production: your Netlify URL, e.g. https://earthyglow.netlify.app
FRONTEND_URL="http://localhost:5173"

# Publicly reachable base URL of THIS API, used to build the Mollie webhookUrl.
# In production set this to the Railway service URL.
# For local webhook testing use a tunnel (e.g. `cloudflared tunnel --url http://localhost:4000`)
# and put that URL here.
PUBLIC_API_URL="http://localhost:4010"

NODE_ENV="development"
