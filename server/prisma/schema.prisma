generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  paid
  failed
  expired
  canceled
  refunded
}

enum FulfillmentStatus {
  open
  processed
}

model Product {
  id         String   @id
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  variants   ProductVariant[]
  recipes    Recipe[]
}

model ProductVariant {
  id         String   @id
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model Customer {
  id        String   @id @default(uuid())
  // Nullable so walk-in sales without contact details can be recorded: a
  // unique index allows many NULLs, whereas a shared "-" would collide.
  email     String?  @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  status          OrderStatus @default(pending)
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  currency        String      @default("EUR")
  paymentMethod   String?
  molliePaymentId String?     @unique
  address         String
  postalCode      String
  city            String
  country         String
  notes           String?
  paidAt          DateTime?
  invoiceSentAt   DateTime?
  // The exact bytes of the PDF that was emailed, archived so the invoice can be
  // re-downloaded verbatim. Null for orders invoiced before this column existed.
  invoicePdf      Bytes?
  newOrderEmailSentAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  fulfillmentStatus FulfillmentStatus @default(open)
  carrier         String?
  trackingCode    String?
  fulfilledAt     DateTime?
  fulfillmentEmailSentAt DateTime?

  items OrderItem[]

  // The admin list and dashboard order by createdAt desc, and the revenue
  // windows filter on status + paidAt; these cover both.
  @@index([status, paidAt])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  name           String
  variantId      String?
  variantLabel   String?
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  // The line's place in the cart. Invoice and admin views sort on this rather
  // than the random uuid id, so lines always read in the order they were added.
  position       Int    @default(0)

  @@index([orderId])
}

// A raw material kept in stock for making candles (wax, scent, …). The
// quantity is stored as a float in `unit` (kg, g, …) and only ever changes
// through recorded stock additions, so the shop can see what is left.
model Material {
  id        String   @id @default(uuid())
  name      String
  // The unit quantities are expressed in, e.g. "kg" or "g". Free text so a
  // new material (wicks, jars) can carry its own unit.
  unit      String
  quantity  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]
}

model Recipe {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients RecipeIngredient[]
  fields      RecipeField[]

  @@index([productId])
}

// One material + amount per recipe line. The amount is in the material's own
// unit (kg wax, g scent), so the leftover-stock calculation per product is a
// simple floor(material.quantity / amount).
model RecipeIngredient {
  id         String   @id @default(uuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  amount     Float

  @@index([recipeId])
  @@index([materialId])
}

// Free-form key/value extras on a recipe ("Cure time" → "48 hours"), kept as
// rows so the admin can add as many as they like.
model RecipeField {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  label    String
  value    String

  @@index([recipeId])
}

// A purchase: materials and supplies bought to make the candles. The entered
// costCents is the VAT-inclusive total from the receipt; the 21% VAT split is
// derived from it (the shop prices everything VAT-inclusive, like the invoice).
model Purchase {
  id            String   @id @default(uuid())
  dateBought    DateTime
  description   String
  costCents     Int
  // The document is optional (a receipt or delivery note). Stored as bytes
  // following the invoice PDF precedent; the client only ever receives the
  // file via a dedicated download endpoint.
  documentName  String?
  documentMime  String?
  documentBytes Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dateBought])
}
