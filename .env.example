# Frontend environment.
# Leave empty in development: the Vite dev server proxies /api to localhost:4010.
# In production (Netlify) set this to your Railway API URL,
# e.g. https://earthyglow-api.up.railway.app
VITE_API_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn
# analytics and the cookie banner off (the default in development).
VITE_GA_MEASUREMENT_ID=
